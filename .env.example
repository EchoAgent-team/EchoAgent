# Groq API key — required for the pipeline's default LLM client (notebooks/pipeline_tests.ipynb,
# and PromptParser/PlannerAgent/PlaylistBuilderAgent/CriticAgent instances built around it).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — only needed if running tests/test_planner_agent.py with --backend hf-api.
HF_TOKEN=

# Optional — overrides the default SQLite path in backend/data/db.py.
# Example: sqlite:///./database/music_relational.db
DATABASE_URL=sqlite:///database/music_relational.db
CHROMA_PERSIST_DIRECTORY=database/chroma_db

# Optional — overrides the default sentence-transformers model in backend/data/embeddings.py.
# Defaults to all-MiniLM-L6-v2 if unset.
LYRICS_EMBEDDING_MODEL=
